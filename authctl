#!/usr/bin/env bash
# authctl — wrapper for manage_users.php

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
MANAGE="${SCRIPT_DIR}/manage_users.php"

USERS_DIR="/etc/simplewebauth"
USERS_FILE="${USERS_DIR}/auth_users.php"

# Self-enrolled MFA overlay — written by the web server process itself, so it
# must stay owned by the web user, not root. Update alongside AUTH_USERS_LOCAL_FILE
# if you've overridden that constant.
LOCAL_DIR="/var/local/simplewebauth"
LOCAL_FILE="${LOCAL_DIR}/auth_users_local.ini"
LOCAL_TRUST_FILE="${LOCAL_DIR}/trusted_devices_local.ini"
LOCAL_STATE_FILE="${LOCAL_DIR}/login_state_local.ini"

# ── web user detection ────────────────────────────────────────────────────────
# Override by setting SIMPLEWEBAUTH_WEB_USER in the environment before calling authctl.

detect_web_user() {
    if [[ -n "${SIMPLEWEBAUTH_WEB_USER:-}" ]]; then
        echo "$SIMPLEWEBAUTH_WEB_USER"
        return
    fi
    for u in www-data apache nginx http; do
        if id "$u" &>/dev/null 2>&1; then
            echo "$u"
            return
        fi
    done
    echo "www-data"  # fallback
}

# ── helpers ───────────────────────────────────────────────────────────────────

die()  { echo "error: $*" >&2; exit 1; }
info() { echo "$*"; }

require_php() {
    command -v php &>/dev/null || die "php not found in PATH"
}

require_manage() {
    [[ -f "$MANAGE" ]] || die "manage_users.php not found at: $MANAGE"
}

ensure_dir() {
    [[ -d "$USERS_DIR" ]] && return 0
    [[ $EUID -eq 0 ]] || die "${USERS_DIR} does not exist — run as root or with sudo to create it"
    local web_user
    web_user="$(detect_web_user)"
    info "Creating ${USERS_DIR}  (owner: root:${web_user}  mode: 750)"
    mkdir -p "$USERS_DIR"
    chown "root:${web_user}" "$USERS_DIR"
    chmod 750 "$USERS_DIR"
}

fix_perms() {
    # Sets the given file (default: $USERS_FILE) to root:<web_user> 640 after
    # any write. Silently skips if not root (PHP already wrote the file;
    # perms just won't be tightened).
    local target="${1:-$USERS_FILE}"
    [[ -f "$target" ]] || return 0
    [[ $EUID -eq 0 ]]  || return 0
    local web_user
    web_user="$(detect_web_user)"
    chown "root:${web_user}" "$target"
    chmod 640 "$target"
}

fix_local_perms() {
    # The local overlay/trust-device files are written by the WEB SERVER
    # process itself — if an admin (root) runs a command that rewrites one,
    # it must stay owned by the web user, or the web server loses write
    # access on the next enrollment/device-trust issuance.
    local target="${1:-$LOCAL_FILE}"
    [[ -f "$target" ]] || return 0
    [[ $EUID -eq 0 ]]  || return 0
    local web_user
    web_user="$(detect_web_user)"
    chown "${web_user}:${web_user}" "$target"
    chmod 600 "$target"
}

run() {
    require_php
    require_manage
    php "$MANAGE" "$@"
}

# ── usage ─────────────────────────────────────────────────────────────────────

usage_main() {
    cat <<EOF
authctl — manage PHP auth users

Usage:
  authctl <command> [options]

Commands:
  list                    List all configured users
  add <username>          Add a new user (prompts for password)
  remove <username>       Remove a user
  passwd <username>       Change a user's password
  migrate [target.ini]    Convert legacy auth_users.php to .ini (required for MFA)
  mfa <subcommand>        MFA management — run 'authctl mfa' for help
  locked                  List locked-out accounts and recent failures
  unlock <username>       Clear a user's lockout and failure count
  check                   Verify environment and show configuration

Options:
  -h, --help              Show this help message

Run 'authctl <command> --help' for command-specific help.
EOF
}

usage_migrate() {
    cat <<EOF
Usage: authctl migrate [target.ini]

Converts the legacy auth_users.php file to the new .ini format, which is
required for MFA support. The original file is left in place, untouched.
Defaults the target to auth_users.ini alongside the source.

After migrating, update AUTH_USERS_FILE (defined before requiring auth.php)
and this script's USERS_FILE variable to point at the new .ini file.

Example:
  authctl migrate
  authctl migrate /etc/simplewebauth/auth_users.ini
EOF
}

usage_mfa() {
    cat <<EOF
Usage: authctl mfa <subcommand>

Subcommands:
  new <username>       Generate a TOTP secret, ntfy topic, and backup codes
                        for offline/vault provisioning. Prints only — writes
                        nothing to disk.
  pending               List self-enrolled MFA data not yet captured into the
                        vault-managed main file, ready to paste.
  merge                 Prune local-overlay fields now redundant with the
                        main file, and expired trusted-device entries. Safe
                        to run anytime.
  disable <username>    Clear self-enrolled MFA data for a user.
  untrust <username>    Revoke all "remembered devices" for a user (lost or
                        stolen device, etc.).

Example:
  authctl mfa new alice
  authctl mfa pending
EOF
}

usage_add() {
    cat <<EOF
Usage: authctl add <username>

Add a new user. You will be prompted to enter a password.
Passwords must be at least 8 characters.
Creates ${USERS_DIR} with correct ownership and permissions if it does not exist (requires root).

Example:
  authctl add alice
  sudo authctl add alice
EOF
}

usage_remove() {
    cat <<EOF
Usage: authctl remove <username>

Remove a user. This action cannot be undone.

Example:
  authctl remove alice
EOF
}

usage_passwd() {
    cat <<EOF
Usage: authctl passwd <username>

Change the password for an existing user.
You will be prompted to enter the new password.

Example:
  authctl passwd alice
EOF
}

# ── commands ──────────────────────────────────────────────────────────────────

cmd_list() {
    run list
}

cmd_add() {
    [[ "${1:-}" == "-h" || "${1:-}" == "--help" ]] && { usage_add; exit 0; }
    [[ $# -lt 1 ]] && { usage_add >&2; exit 1; }
    local username="$1"
    ensure_dir
    run add "$username"
    fix_perms
}

cmd_remove() {
    [[ "${1:-}" == "-h" || "${1:-}" == "--help" ]] && { usage_remove; exit 0; }
    [[ $# -lt 1 ]] && { usage_remove >&2; exit 1; }
    local username="$1"

    read -r -p "Remove user '${username}'? This cannot be undone. [y/N] " confirm
    [[ "$confirm" =~ ^[Yy]$ ]] || { info "Aborted."; exit 0; }

    run remove "$username"
    fix_perms
}

cmd_passwd() {
    [[ "${1:-}" == "-h" || "${1:-}" == "--help" ]] && { usage_passwd; exit 0; }
    [[ $# -lt 1 ]] && { usage_passwd >&2; exit 1; }
    local username="$1"
    run passwd "$username"
    fix_perms
}

cmd_migrate() {
    [[ "${1:-}" == "-h" || "${1:-}" == "--help" ]] && { usage_migrate; exit 0; }
    local target="${1:-${USERS_DIR}/auth_users.ini}"
    run migrate "$target"
    fix_perms "$target"
}

cmd_mfa() {
    if [[ "${1:-}" == "-h" || "${1:-}" == "--help" || -z "${1:-}" ]]; then
        usage_mfa
        exit 0
    fi
    local sub="$1"; shift
    case "$sub" in
        new)
            [[ $# -lt 1 ]] && { echo "Usage: authctl mfa new <username>" >&2; exit 1; }
            run mfa new "$1"
            ;;
        pending)
            run mfa pending
            ;;
        merge)
            run mfa merge
            fix_local_perms
            fix_local_perms "$LOCAL_TRUST_FILE"
            ;;
        disable)
            [[ $# -lt 1 ]] && { echo "Usage: authctl mfa disable <username>" >&2; exit 1; }
            run mfa disable "$1"
            fix_local_perms
            ;;
        untrust)
            [[ $# -lt 1 ]] && { echo "Usage: authctl mfa untrust <username>" >&2; exit 1; }
            run mfa untrust "$1"
            fix_local_perms "$LOCAL_TRUST_FILE"
            ;;
        *)
            echo "Unknown mfa subcommand: $sub" >&2
            usage_mfa >&2
            exit 1
            ;;
    esac
}

cmd_locked() {
    run locked
}

cmd_unlock() {
    [[ $# -lt 1 || "${1:-}" == "-h" || "${1:-}" == "--help" ]] && {
        echo "Usage: authctl unlock <username>"
        echo
        echo "Clears a brute-force lockout (and the failure count) for a user on this host."
        [[ $# -lt 1 ]] && exit 1 || exit 0
    }
    run unlock "$1"
    fix_local_perms "$LOCAL_STATE_FILE"
    fix_local_perms "${LOCAL_STATE_FILE}.lock"
}

cmd_check() {
    local ok=true
    local web_user
    web_user="$(detect_web_user)"

    if command -v php &>/dev/null; then
        info "  php:              $(command -v php) ($(php -r 'echo PHP_VERSION;'))"
    else
        info "  php:              NOT FOUND"
        ok=false
    fi

    if [[ -f "$MANAGE" ]]; then
        info "  manage_users.php: $MANAGE"
    else
        info "  manage_users.php: NOT FOUND at $MANAGE"
        ok=false
    fi

    if [[ -d "$USERS_DIR" ]]; then
        info "  users dir:        $USERS_DIR  $(stat -c 'owner:%U:%G mode:%a' "$USERS_DIR")"
    else
        info "  users dir:        NOT FOUND at $USERS_DIR (run 'sudo authctl add <user>' to create)"
        ok=false
    fi

    if [[ -f "$USERS_FILE" ]]; then
        info "  users file:       $USERS_FILE  $(stat -c 'owner:%U:%G mode:%a' "$USERS_FILE")"
    else
        info "  users file:       NOT FOUND (will be created on first 'add')"
    fi

    info "  web user:         ${web_user}  (override with SIMPLEWEBAUTH_WEB_USER)"

    if [[ "$USERS_FILE" == *.ini ]]; then
        info "  format:           .ini (MFA available)"
    else
        info "  format:           legacy .php (MFA unavailable — run 'authctl migrate')"
    fi

    if [[ -d "$LOCAL_DIR" ]]; then
        info "  local overlay:    $LOCAL_DIR  $(stat -c 'owner:%U:%G mode:%a' "$LOCAL_DIR")"
    else
        info "  local overlay:    not yet created (created automatically on first self-enrollment)"
    fi

    $ok && info $'\nAll checks passed.' || { info $'\nOne or more checks failed.'; exit 1; }
}

# ── main ──────────────────────────────────────────────────────────────────────

[[ $# -eq 0 ]] && { usage_main; exit 0; }

case "$1" in
    list)            shift; cmd_list "$@" ;;
    add)             shift; cmd_add "$@" ;;
    remove|rm|del)   shift; cmd_remove "$@" ;;
    passwd|password) shift; cmd_passwd "$@" ;;
    migrate)         shift; cmd_migrate "$@" ;;
    mfa)             shift; cmd_mfa "$@" ;;
    locked)          shift; cmd_locked "$@" ;;
    unlock)          shift; cmd_unlock "$@" ;;
    check)           shift; cmd_check "$@" ;;
    -h|--help|help)  usage_main; exit 0 ;;
    *)               echo "Unknown command: $1"; echo; usage_main >&2; exit 1 ;;
esac
