# Block direct web access to sensitive PHP files
<FilesMatch "^manage_users\.php$">
    Require all denied
</FilesMatch>

# MFA / branding library files are include-only — never a direct web target
<FilesMatch "^(mfa_(config|store|totp|ntfy|qr|session)|branding)\.php$">
    Require all denied
</FilesMatch>

# Block documentation, scripts, and other non-web files
<FilesMatch "^(README\.md|LICENSE|authctl)$">
    Require all denied
</FilesMatch>

# Block dot-directories (returns 404 rather than 403 to avoid confirming existence)
RedirectMatch 404 ^/\.git(/|$)
